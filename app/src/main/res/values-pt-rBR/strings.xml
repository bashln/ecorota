    <string name="onboarding_auto_detection_body">Opcional. Procura viagens em segundo plano e inicia o registro sozinho.</string>
    <string name="onboarding_permissions_optional_note">As permissões são opcionais. Você pode conceder ou revogar depois nos Ajustes e nas configurações do sistema.</string>
    <string name="onboarding_vehicle_title">Fale sobre o seu carro</string>
    <string name="onboarding_vehicle_body">O consumo médio e o preço do combustível transformam desperdício em dinheiro. Você pode mudar esses valores depois nos Ajustes.</string>
