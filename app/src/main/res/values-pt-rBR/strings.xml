    <!-- Location and auto-detection permissions -->
    <string name="location_permission_denied_title">Permissão de localização necessária</string>
    <string name="location_permission_denied_body">O EcoRota não consegue detectar nem gravar viagens sem acesso à localização. Você pode permitir nos ajustes do aplicativo.</string>
    <string name="auto_detection_background_title">Permitir localização o tempo todo?</string>
    <string name="auto_detection_background_disclosure">A detecção automática procura viagens enquanto o EcoRota está em segundo plano, para que uma viagem comece sem você abrir o aplicativo. A localização é lida cerca de uma vez por minuto e apenas para detectar o início e o fim de um trajeto. Você pode desligar isso a qualquer momento nos Ajustes.</string>
    <string name="auto_detection_background_allow">Permitir o tempo todo</string>
    <string name="auto_detection_settings_title">Ativar localização em segundo plano</string>
    <string name="auto_detection_settings_body">No Android 11 e mais recentes o sistema não mostra uma janela para localização em segundo plano. Abra os ajustes do aplicativo, escolha Permissões, depois Localização, e selecione Permitir o tempo todo. Sem isso, a detecção automática só funciona com o EcoRota aberto.</string>

    <!-- Onboarding -->
    <string name="onboarding_continue">Continuar</string>
    <string name="onboarding_back">Voltar</string>
    <string name="onboarding_finish">Começar a usar o EcoRota</string>
    <string name="onboarding_step_indicator">Etapa %1$d de %2$d</string>
    <string name="onboarding_privacy_title">Seus dados de direção ficam no seu celular</string>
    <string name="onboarding_privacy_body">O EcoRota avalia a eficiência da sua direção e mostra o combustível desperdiçado pelos seus hábitos. Tudo é local: sem conta, sem anúncios, sem análise de uso e sem nuvem.</string>
    <string name="onboarding_benefit_offline_title">Funciona offline</string>
    <string name="onboarding_benefit_offline_body">Gravar e calcular a nota nunca precisa de conexão. Os mapas são o único download opcional.</string>
    <string name="onboarding_benefit_account_title">Sem conta</string>
    <string name="onboarding_benefit_account_body">Nada para cadastrar. As viagens ficam em um banco de dados neste aparelho.</string>
    <string name="onboarding_benefit_ads_title">Sem anúncios, sem rastreamento</string>
    <string name="onboarding_benefit_ads_body">Nenhum SDK de anúncios, nenhuma análise de uso, nenhum rastreador.</string>
    <string name="onboarding_privacy_storage">Apagar uma viagem, ou desinstalar o EcoRota, remove os dados deste aparelho de forma permanente.</string>
    <string name="onboarding_permissions_title">Localização e notificações</string>
    <string name="onboarding_permissions_disclosure">O EcoRota usa sua localização para detectar e gravar viagens. Durante uma viagem ele lê posição e velocidade do GPS e usa o sensor de movimento para identificar frenagens, acelerações e curvas bruscas. A localização em segundo plano só é lida se você ativar a detecção automática. Os dados das viagens nunca são enviados.</string>
    <string name="onboarding_permissions_location_label">Localização precisa</string>
    <string name="onboarding_permissions_notifications_label">Notificações</string>
    <string name="onboarding_permissions_allow">Permitir localização e notificações</string>
    <string name="onboarding_permissions_allowed">Permissões concedidas</string>
