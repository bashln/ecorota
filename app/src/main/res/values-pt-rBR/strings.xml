    <!-- Driving tips -->
    <string name="tip_smooth_acceleration_title">Acelere com suavidade</string>
    <string name="tip_smooth_acceleration_body">Pise no acelerador de forma progressiva. Arrancadas fortes queimam combustível sem percorrer mais distância.</string>
    <string name="tip_anticipate_braking_title">Antecipe as frenagens</string>
    <string name="tip_anticipate_braking_body">Tire o pé cedo e deixe o carro reduzir. Toda freada forte transforma movimento em calor desperdiçado.</string>
    <string name="tip_ease_through_corners_title">Faça as curvas com calma</string>
    <string name="tip_ease_through_corners_body">Frene antes da curva e acelere depois. Curvas rápidas custam aderência e combustível.</string>
    <string name="tip_slow_highway_speed_title">Reduza a velocidade de cruzeiro</string>
    <string name="tip_slow_highway_speed_body">O arrasto cresce com o quadrado da velocidade. Alguns km/h a menos economizam combustível em trechos longos.</string>
    <string name="tip_avoid_idling_title">Evite ficar parado com o motor ligado</string>
    <string name="tip_avoid_idling_body">Se você ficar parado por mais de um minuto, desligue o motor quando for seguro.</string>
    <string name="tip_keep_steady_pace_title">Mantenha um ritmo constante</string>
    <string name="tip_keep_steady_pace_body">Uma direção suave e previsível mantém sua nota alta. Continue assim.</string>

