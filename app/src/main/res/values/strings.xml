    <!-- Driving tips -->
    <string name="tip_smooth_acceleration_title">Accelerate gently</string>
    <string name="tip_smooth_acceleration_body">Press the pedal progressively. Hard starts burn fuel without covering more distance.</string>
    <string name="tip_anticipate_braking_title">Anticipate braking</string>
    <string name="tip_anticipate_braking_body">Lift off early and let the car slow down. Every hard brake turns momentum into wasted heat.</string>
    <string name="tip_ease_through_corners_title">Ease through corners</string>
    <string name="tip_ease_through_corners_body">Brake before the curve and accelerate after it. Fast cornering costs grip and fuel.</string>
    <string name="tip_slow_highway_speed_title">Lower the cruising speed</string>
    <string name="tip_slow_highway_speed_body">Drag grows with the square of speed. A few kilometers per hour less saves fuel on long stretches.</string>
    <string name="tip_avoid_idling_title">Avoid long idling</string>
    <string name="tip_avoid_idling_body">If you are stopped for more than a minute, turn the engine off when it is safe.</string>
    <string name="tip_keep_steady_pace_title">Keep a steady pace</string>
    <string name="tip_keep_steady_pace_body">Smooth, predictable driving keeps your score high. Keep doing what you are doing.</string>

