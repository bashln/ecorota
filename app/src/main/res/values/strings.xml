    <string name="onboarding_safety_title">Before you drive</string>
    <string name="onboarding_safety_subtitle">Important reminders for your safety</string>
    <string name="onboarding_safety_laws">Follow traffic laws and local speed limits. Never drive recklessly.</string>
    <string name="onboarding_safety_parked">Start and stop recording only when safely parked.</string>
    <string name="onboarding_safety_mount">Use a phone mount, as with any navigation app.</string>
    <string name="onboarding_safety_no_phone">Do not touch the phone while driving. Eyes on the road.</string>
    <string name="onboarding_safety_acknowledge">I acknowledge these guidelines and commit to driving responsibly.</string>
    <string name="onboarding_safety_disclaimer">You are responsible for your driving. EcoRota is a recording tool and does not encourage speeding or dangerous driving.</string>
    <string name="onboarding_safety_accept">Accept and continue</string>
    <string name="onboarding_privacy_title">Your driving data stays on your phone</string>
    <string name="onboarding_privacy_body">EcoRota scores how efficiently you drive and shows the fuel your habits waste. Everything is local: no account, no ads, no analytics and no cloud.</string>
    <string name="onboarding_benefit_offline_title">Works offline</string>
    <string name="onboarding_benefit_offline_body">Recording and scoring never need a connection. Map tiles are the only optional download.</string>
    <string name="onboarding_benefit_account_title">No account</string>
    <string name="onboarding_benefit_account_body">Nothing to sign up for. Trips live in a database on this device.</string>
    <string name="onboarding_benefit_ads_title">No ads, no tracking</string>
    <string name="onboarding_benefit_ads_body">No advertising SDKs, no analytics, no trackers of any kind.</string>
    <string name="onboarding_privacy_storage">Deleting a trip, or uninstalling EcoRota, permanently removes its data from this device.</string>
    <string name="onboarding_permissions_title">Location and notifications</string>
    <string name="onboarding_permissions_disclosure">EcoRota uses your location to detect and record drives. While a trip is recording it reads GPS position and speed, and uses the motion sensor to spot hard braking, acceleration and cornering. Background location is read only if you enable auto-detection. Trip data is never uploaded.</string>
